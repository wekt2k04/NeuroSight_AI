   <string notr="true">QMainWindow { background-color: #0c1118; }
QWidget { color: #d7e1ef; font-family: &quot;Segoe UI&quot;; }
QGroupBox {
    border: 1px solid #243346;
    border-radius: 12px;
    margin-top: 14px;
    background: #131b26;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9ec8ff;
    font-weight: 600;
}
QPushButton {
    border-radius: 10px;
    border: 1px solid #2f4662;
    padding: 10px 14px;
    font-weight: 600;
}
QPushButton#uploadButton {
    background-color: #22476b;
}
QPushButton#uploadButton:hover {
    background-color: #2a5b89;
}
QPushButton#analyzeButton {
    background-color: #1c7b58;
    border-color: #2ca677;
    font-size: 16px;
}
QPushButton#analyzeButton:hover {
    background-color: #229468;
}
QPushButton#analyzeButton:disabled {
    background-color: #263341;
    color: #8fa2b7;
    border-color: #354559;
}
QLabel#imagePreviewLabel, QLabel#heatmapLabel {
    border: 1px solid #2f4155;
    border-radius: 10px;
    background-color: #101722;
    color: #7d92ad;
}
QLineEdit#diseaseStageLabel {
    background-color: #0f1621;
    border: 1px solid #35557a;
    border-radius: 8px;
    padding: 8px;
    color: #d4ebff;
    font-weight: 600;
}
QProgressBar {
    border: 1px solid #33475f;
    border-radius: 8px;
    text-align: center;
    background: #101722;
    color: #cce2ff;
}
QProgressBar::chunk {
    background: #2f8ecf;
    border-radius: 6px;
}
